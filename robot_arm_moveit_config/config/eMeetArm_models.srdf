<?xml version="1.0" encoding="UTF-8"?>
<robot name="eMeetArm_models">

  <!-- 虚拟关节：arm_base_link 固定到世界坐标系 -->
  <virtual_joint name="virtual_joint" type="fixed"
                 parent_frame="world" child_link="arm_base_link"/>

  <!-- 规划组：arm_base_link → gimbal_tool0 的完整 6 轴运动链
       （臂 Joint1-3 + 云台 V2 Joint4-6，中间 tool0 / gimbal_base_link 是 fixed）。
       2026-07-28 云台换 V2：tip 由 tool0 改为 gimbal_tool0。
       原因：tool0 现在是臂末端法兰（Link3 +X 300mm，J3 之后），若仍以它为 tip，
       规划组会缩成 3 轴，笛卡尔类控制（cartesian_moveit / realtime_ik /
       trajectory / spherical_orbit / Servo）全部失去姿态自由度。
       gimbal_tool0 是云台 Joint6 之后的安装板，正是 V1 里 tool0 的对应位置。 -->
  <group name="arm">
    <chain base_link="arm_base_link" tip_link="gimbal_tool0"/>
  </group>

  <!-- 末端执行器：gimbal_tool0 为末端坐标系，无独立夹爪组 -->
  <end_effector name="gimbal_tool0" parent_link="gimbal_tool0" group="arm"/>

  <!-- 预定义姿态：零位 -->
  <group_state name="home" group="arm">
    <joint name="Joint1" value="0"/>
    <joint name="Joint2" value="0"/>
    <joint name="Joint3" value="0"/>
    <joint name="Joint4" value="0"/>
    <joint name="Joint5" value="0"/>
    <joint name="Joint6" value="0"/>
  </group_state>

  <!-- ══ 禁用碰撞对 ═══════════════════════════════════════════════════════════
       2026-07-28 云台换 V2（C-200T 三轴）后的拓扑：
         Link3 → tool0(臂法兰) → gimbal_base_link → Joint4 → Link4 → Link5 → Link6
                                      │                        └→ gimbal_tool0 → Cam0
                                      ├→ Cam1（基座固定）
                                      └→ Tof （基座固定）
       tool0 / camera_optical_frame 是无几何的纯坐标系，本身不参与碰撞检查，
       仍列出相邻对以免 MoveIt 反复告警。
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- 相邻连杆（物理上不可能碰撞） -->
  <disable_collisions link1="arm_base_link" link2="Link1" reason="Adjacent"/>
  <disable_collisions link1="Link1" link2="Link2" reason="Adjacent"/>
  <disable_collisions link1="Link2" link2="Link3" reason="Adjacent"/>
  <disable_collisions link1="Link3" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="gimbal_base_link" reason="Adjacent"/>
  <disable_collisions link1="gimbal_base_link" link2="Cam1"  reason="Adjacent"/>
  <disable_collisions link1="gimbal_base_link" link2="Tof"   reason="Adjacent"/>
  <disable_collisions link1="gimbal_base_link" link2="Link4" reason="Adjacent"/>
  <disable_collisions link1="Link4" link2="Link5" reason="Adjacent"/>
  <disable_collisions link1="Link5" link2="Link6" reason="Adjacent"/>
  <disable_collisions link1="Link6" link2="gimbal_tool0" reason="Adjacent"/>
  <disable_collisions link1="gimbal_tool0" link2="Cam0" reason="Adjacent"/>

  <!-- 云台内部：基座上的固定传感器与转动部分互不检查（同一装配体，间隙由机构保证） -->
  <disable_collisions link1="Cam1" link2="Tof"   reason="Never"/>
  <disable_collisions link1="Cam1" link2="Link4" reason="Never"/>
  <disable_collisions link1="Cam1" link2="Link5" reason="Never"/>
  <disable_collisions link1="Cam1" link2="Link6" reason="Never"/>
  <disable_collisions link1="Cam1" link2="gimbal_tool0" reason="Never"/>
  <disable_collisions link1="Cam1" link2="Cam0"  reason="Never"/>
  <disable_collisions link1="Tof"  link2="Link4" reason="Never"/>
  <disable_collisions link1="Tof"  link2="Link5" reason="Never"/>
  <disable_collisions link1="Tof"  link2="Link6" reason="Never"/>
  <disable_collisions link1="Tof"  link2="gimbal_tool0" reason="Never"/>
  <disable_collisions link1="Tof"  link2="Cam0"  reason="Never"/>
  <disable_collisions link1="gimbal_base_link" link2="Link5" reason="Never"/>
  <disable_collisions link1="gimbal_base_link" link2="Link6" reason="Never"/>
  <disable_collisions link1="gimbal_base_link" link2="gimbal_tool0" reason="Never"/>
  <disable_collisions link1="gimbal_base_link" link2="Cam0" reason="Never"/>
  <disable_collisions link1="Link4" link2="Link6" reason="Never"/>
  <disable_collisions link1="Link4" link2="gimbal_tool0" reason="Never"/>
  <disable_collisions link1="Link4" link2="Cam0" reason="Never"/>
  <disable_collisions link1="Link5" link2="gimbal_tool0" reason="Never"/>
  <disable_collisions link1="Link5" link2="Cam0" reason="Never"/>
  <disable_collisions link1="Link6" link2="Cam0" reason="Never"/>

  <!-- 臂内部：间隔连杆（运动范围内几何上不可达） -->
  <disable_collisions link1="arm_base_link" link2="Link2" reason="Never"/>
  <disable_collisions link1="Link1" link2="Link3" reason="Never"/>
  <disable_collisions link1="Link2" link2="tool0" reason="Never"/>
  <disable_collisions link1="Link3" link2="gimbal_base_link" reason="Never"/>
  <disable_collisions link1="Link3" link2="Cam1"  reason="Never"/>
  <disable_collisions link1="Link3" link2="Tof"   reason="Never"/>
  <disable_collisions link1="Link3" link2="Link4" reason="Never"/>
  <disable_collisions link1="tool0" link2="Cam1"  reason="Never"/>
  <disable_collisions link1="tool0" link2="Tof"   reason="Never"/>
  <disable_collisions link1="tool0" link2="Link4" reason="Never"/>

</robot>
