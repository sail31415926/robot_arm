<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_arm_moveit_config</name>
  <version>1.0.0</version>
  <description>
    eMeetArm 的 MoveIt 配置包（社区标准 moveit_config 布局）：
    SRDF、kinematics（pick_ik）、joint_limits、OMPL 规划管线、
    三后端 controller 配置（gazebo=Ros2ControlManager / real+mujoco=SimpleControllerManager）、
    MoveIt Servo 配置及 move_group+RViz 启动入口。
    URDF 本体在 robot_arm_description（见 .setup_assistant）。
  </description>
  <maintainer email="sw.claude.Ethan@emeet.com">eMeet</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- URDF/xacro 来源包 -->
  <exec_depend>robot_arm_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- MoveIt 运行时（本包 launch/config 实际拉起或以插件形式加载的全部包） -->
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>          <!-- planning_pipeline.yaml: ompl_interface/OMPLPlanner -->
  <exec_depend>pick_ik</exec_depend>                       <!-- kinematics.yaml: pick_ik/PickIkPlugin -->
  <exec_depend>moveit_simple_controller_manager</exec_depend>   <!-- moveit_controllers_{real,mujoco}.yaml -->
  <exec_depend>moveit_ros_control_interface</exec_depend>  <!-- moveit_controllers.yaml: Ros2ControlManager (gazebo) -->
  <exec_depend>moveit_servo</exec_depend>                  <!-- servo_config.yaml 的消费者由各后端 launch 拉起 -->

  <!-- RViz（moveit.launch.py rviz:=true 时） -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>

  <!-- launch 基础设施 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
