# ArmExecuteMotion.action
# 机械臂运镜动作：执行一段运镜（抬升/推拉/横移/环绕）并等待完成
# 客户端：上层（Director）
# 服务端：Motion Executor（robot_arm_node 包）
#
# exit_reason: "reached" | "timeout" | "cancelled" | "error"
#
# ─── 运动类型常量 ───
uint8 MODE_CRANE = 0     # 抬升下降
uint8 MODE_DOLLY = 1     # 推拉
uint8 MODE_TRUCK = 2     # 横移
uint8 MODE_ARC   = 3     # 环绕
# ─── 速度曲线常量 ───
uint8 PROFILE_SMOOTH = 0    # 缓入缓出
uint8 PROFILE_LINEAR = 1    # 匀速
# ─── Goal ──────────────────────────────────────────────────────────────────
uint8   motion_type          # 运动类型，取值为上方常量之一
uint8   speed_profile        # 速度曲线，取值为上方常量之一
float32 duration_s           # 运镜时长（秒），决定运动快慢

# 抬升下降 / 推拉 / 横移参数（非 MODE_ARC 时有效），>0 抬升 / 前推 / 右移
float32 move_distance_m      # 移动距离（米）
# 环绕参数（仅 motion_type == MODE_ARC 时有效）
float32 arc_radius_m         # 环绕半径（米）
float32 arc_degree           # 环绕角度（度），正值顺时针
---
# ─── Result ────────────────────────────────────────────────────────────────
bool    success              # 运镜是否完成
string  exit_reason          # "reached" | "timeout" | "cancelled" | "error"
uint8   error_code           # 失败时的错误码（对应 ArmStatus.ERR_*）
---
# ─── Feedback ──────────────────────────────────────────────────────────────
float32 progress_percent     # 进度百分比 [0.0, 100.0]
float32 elapsed_sec          # 已执行时长（秒）
