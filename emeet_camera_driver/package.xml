<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>emeet_camera_driver</name>
  <version>0.1.0</version>
  <description>Unified high-performance C++ ROS 2 driver for EMEET Pixy, E7002, and Piko cameras.</description>
  <maintainer email="emeet@todo.todo">emeet</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <build_depend>pkg-config</build_depend>
  <build_depend>libudev-dev</build_depend>
  <build_depend>libhidapi-dev</build_depend>

  <exec_depend>libudev</exec_depend>
  <exec_depend>libhidapi-libusb0</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/emeet_camera_hardware_plugin.xml"/>
  </export>
</package>
