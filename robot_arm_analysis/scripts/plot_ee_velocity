#!/usr/bin/env python3
"""离线绘制末端速度曲线。

用法:
    plot_ee_velocity arm_status_20240101_120000.csv
    plot_ee_velocity arm_status_*.csv --save ./figs
"""
import argparse
from pathlib import Path

import matplotlib.pyplot as plt

from arm_analysis.plotter import load_arm_status, plot_ee_velocity


def main():
    parser = argparse.ArgumentParser(
        description='从 arm_status CSV 绘制末端速度曲线')
    parser.add_argument('csv', nargs='+', help='arm_status_*.csv 文件')
    parser.add_argument('--save', metavar='DIR',
                        help='将图片保存到指定目录而不是弹窗显示')
    args = parser.parse_args()

    if args.save:
        Path(args.save).mkdir(parents=True, exist_ok=True)

    for path in args.csv:
        df = load_arm_status(path)
        fig = plot_ee_velocity(df, title=f'末端速度 — {Path(path).name}')
        if args.save:
            out = Path(args.save) / (Path(path).stem + '_ee_velocity.png')
            fig.savefig(out, dpi=150)
            print(f'Saved → {out}')
        else:
            plt.show()


if __name__ == '__main__':
    main()
