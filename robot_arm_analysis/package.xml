<?xml version="1.0"?>
<package format="3">
  <name>robot_arm_analysis</name>
  <version>0.1.0</version>
  <description>机械臂运动数据采集与分析：末端速度、关节力矩等实验数据曲线绘制</description>
  <maintainer email="sw.claude.Ethan@emeet.com">eMeet</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>robot_arm_interfaces</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
