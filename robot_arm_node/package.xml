<?xml version="1.0"?>
<package format="3">
  <name>robot_arm_node</name>
  <version>0.2.0</version>
  <description>Product-level application layer for eMeet robotic arm:
    C++ motion / state / commander stack (arm_commander_node).
    调试工具与视觉感知见 robot_arm_debug。</description>
  <maintainer email="ruichao.liu@emeet.com">ruichao.liu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rcl_interfaces</depend>
  <depend>moveit_msgs</depend>
  <depend>robot_arm_interfaces</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2</depend>
  <depend>trajectory_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>                   <!-- mode_manager_node 速度/力矩总线 Float64MultiArray -->
  <depend>controller_manager_msgs</depend>    <!-- mode_manager_node switch_controller -->
  <depend>ruckig</depend>          <!-- MotionExecutor OTG，CMake find_package(ruckig REQUIRED) -->
  <depend>urdf</depend>            <!-- motion/joint_limits：解析 /robot_description 取关节限位 -->
  <depend>eigen</depend>           <!-- motion/jacobian：3×3 SVD / DLS 伪逆（笛卡尔速度控制） -->
  <depend>pinocchio</depend>       <!-- motion/gravity_model：力矩模式的重力补偿 g(q) -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
