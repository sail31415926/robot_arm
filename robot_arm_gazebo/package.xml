<?xml version="1.0"?>
<package format="3">
  <name>robot_arm_gazebo</name>
  <version>1.0.0</version>
  <description>Gazebo simulation backend for eMeet robotic arm (worlds, models, launch)</description>
  <maintainer email="support@emeet.com">EMEET Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 复用 robot_arm_bringup 的 launch_common 模块 / camera_view.launch.py，
       以及 robot_arm_moveit_config 的 moveit.launch.py 与 MoveIt 配置
       （bringup 反向 include 本包 launch，为避免循环依赖只声明本方向） -->
  <exec_depend>robot_arm_bringup</exec_depend>
  <exec_depend>robot_arm_moveit_config</exec_depend>
  <exec_depend>robot_arm_description</exec_depend>
  <exec_depend>robot_gimbal_description_v2</exec_depend>   <!-- 云台 V2 网格，GAZEBO_MODEL_PATH 需要 -->
  <exec_depend>robot_arm_node</exec_depend>
  <exec_depend>robot_arm_debug</exec_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>   <!-- planar_move(world)/camera(URDF) 插件 -->
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
