    <model name="obj_sphere_yellow">
      <static>false</static>
      <pose>0.25 0.72 0.475 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass>
          <inertia><ixx>2e-5</ixx><iyy>2e-5</iyy><izz>2e-5</izz></inertia>
        </inertial>
        <collision name="col"><geometry><sphere><radius>0.025</radius></sphere></geometry></collision>
        <visual name="vis">
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <material>
            <ambient>0.95 0.82 0.05 1</ambient>
            <diffuse>0.95 0.82 0.05 1</diffuse>
            <specular>0.5 0.5 0.1 50</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════
         移动红色方块（物理模型 + libgazebo_ros_planar_move 插件）
         ─────────────────────────────────────────────────────────────────
         尺寸：0.06m(X)×0.04m(Y)×0.04m(Z)（与 red_box_detector 一致）
         运动：顺时针圆周，圆心 (0.65, 0)，r=0.10 m，T=12 s（贴近机械臂工作区）
           v = 2π·0.10/12 ≈ 0.0524 m/s
           ω = 2π/12      ≈ 0.5236 rad/s（顺时针取负）
         初始位姿 (0.75, -0.10, 0.47)，yaw=-π/2（朝 -Y，偏左 10cm）
           → ICR 在右侧 0.10 m 处 = 世界坐标 (0.65, -0.10)
         话题：/red_box/cmd_vel，由 gazebo.launch.py 自动发布
    ═══════════════════════════════════════════════════════════════════ -->
    <model name="obj_box_red">
      <static>false</static>
      <pose>0.75 -0.10 0.47 0 0 -1.5708</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.06 0.04 0.04</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.06 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.85 0.12 0.10 1</ambient>
            <diffuse>0.85 0.12 0.10 1</diffuse>
            <specular>0.3 0.1 0.1 20</specular>
          </material>
        </visual>
      </link>
      <plugin name="box_circle_mover" filename="libgazebo_ros_planar_move.so">
        <ros>
          <namespace>/red_box</namespace>
        </ros>
        <update_rate>20</update_rate>
        <publish_odom>false</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
      </plugin>
    </model>

  </world>
</sdf>
