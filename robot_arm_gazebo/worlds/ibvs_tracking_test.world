      <static>true</static>
      <pose>0.80 0 0.453 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.64 0.74 0.005</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.64 0.74 0.005</size></box></geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
            <specular>0.03 0.03 0.03 5</specular>
          </material>
        </visual>
      </link>
    </model>

