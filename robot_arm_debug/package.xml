<?xml version="1.0"?>
<package format="3">
  <name>robot_arm_debug</name>
  <version>0.1.0</version>
  <description>Debug / development tools for eMeet robotic arm:
    Python debug controllers + PyQt GUIs, and vision perception
    (visp_ibvs_node, red_box_detector — 暂归调试，成熟后再升产品包).
    产品部署无需安装本包（robot_arm_node 为产品层）。</description>
  <maintainer email="support@emeet.com">EMEET Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ 视觉节点（visp_ibvs_node）。可选依赖 VISP / ros2_algo_vision_interfaces
       用 find_package(QUIET)，缺省自动跳过该节点，故不在此强声明（rosdep key: visp） -->
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>pinocchio</depend>

  <!-- Python 调试控制器 / GUI（ruckig python 绑定走 pip，见 requirements.txt） -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_arm_interfaces</exec_depend>
  <exec_depend>python3-tk</exec_depend>       <!-- tkinter GUI ×7 -->
  <exec_depend>python3-pyqt5</exec_depend>    <!-- joint_position_gui -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>   <!-- red_box_detector -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
