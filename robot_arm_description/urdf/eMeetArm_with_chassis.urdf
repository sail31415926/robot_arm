<!--
  eMeetArm_with_chassis.urdf
  合并描述：FW-mini 底盘 + eMeetArm 机械臂

  TF 树结构：
    base_link (底盘根节点，nav2 使用)
      └─ arm_base_joint (fixed)
           └─ arm_base_link (机械臂基座，原 base_link 重命名)
                └─ Joint1 → Link1
                     └─ Joint2 → Link2
                          └─ Joint3 → Link3
                               └─ Joint4 → Link4
                                    └─ Joint5 → Link5
                                         └─ Joint6 → Link6
                                              └─ tool0_joint → tool0
                                                   └─ camera_optical_joint → camera_optical_frame

  说明：
  - 删除了原机械臂 URDF 中的 world / world_joint，底盘 base_link 作为根节点
  - 机械臂原 base_link 重命名为 arm_base_link，避免与底盘冲突
  - arm_base_joint 的 origin xyz 为机械臂相对底盘的安装偏移，按实物测量后调整
  - 底盘 robot_state_publisher 已在 FW-mini.launch.py 中禁用，
    由 real.launch.py 统一发布此 URDF
-->
<robot name="eMeetArm_with_chassis">

  <!-- ══════════════════════════════════════════════════════════════════
       底盘（FW-mini）
       base_link 为整个机器人的根坐标系（TF 树根节点，nav2 导航使用）
       ════════════════════════════════════════════════════════════════ -->
  <link name="base_link">
    <visual>
      <origin xyz="0.235 0.175 0" rpy="1.57 0 -1.57"/>
      <geometry>
        <mesh filename="package://yhs_chassis_description/meshes/FW-mini.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.235 0.175 0" rpy="1.57 0 -1.57"/>
      <geometry>
        <mesh filename="package://yhs_chassis_description/meshes/FW-mini.STL"/>
      </geometry>
    </collision>
    <!-- 占位惯量：实物模式不使用，仿真时按实际质量调整 -->
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.8"/>
    </inertial>
  </link>

  <!-- 机械臂安装关节：底盘 base_link → 机械臂 arm_base_link（固定）
       请按实物测量机械臂基座相对底盘原点的位置后修改 xyz -->
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0 0 0.31" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════
       机械臂（eMeetArm）
       原 base_link 重命名为 arm_base_link，避免与底盘 base_link 冲突
       ════════════════════════════════════════════════════════════════ -->
  <link name="arm_base_link">
    <inertial>
      <origin
        xyz="-1.26513871156475E-05 -1.5742724565615E-05 0.0452777610383739"
        rpy="0 0 0"/>
      <mass value="2.9887249749171"/>
      <inertia
        ixx="0.0136862770640689"
        ixy="6.69045000229793E-07"
        ixz="-3.08621535501323E-07"
        iyy="0.0112779246258948"
        iyz="-2.26930660317598E-07"
        izz="0.0223184454586288"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.22 0.22 0.23 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <link name="Link1">
    <inertial>
      <origin
        xyz="-7.4393277062379E-05 -0.00743203317797858 0.128765008589431"
        rpy="0 0 0"/>
      <mass value="2.35824980558236"/>
      <inertia
        ixx="0.00383791573125331"
        ixy="7.01396501492847E-07"
        ixz="-3.09202743571665E-06"
        iyy="0.00465819508220185"
        iyz="-0.000530039602599771"
        izz="0.00221408091488039"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Link1.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Link1.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="Joint1" type="revolute">
    <origin xyz="0 0 0.1078" rpy="0 0 0"/>
    <parent link="arm_base_link"/>
    <child link="Link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1" upper="3.1" effort="5" velocity="3.14"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <link name="Link2">
    <inertial>
      <origin
        xyz="0.262334166073163 -2.30075418332643E-05 0.0292792731278192"
        rpy="0 0 0"/>
      <mass value="1.23593589919935"/>
      <inertia
        ixx="0.000521066265507803"
        ixy="1.66498206532369E-07"
        ixz="1.28943373675324E-05"
        iyy="0.00836492400345204"
        iyz="-2.82843566382884E-07"
        izz="0.00851304966664655"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Link2.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.28 0.27 0.27 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Link2.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="Joint2" type="revolute">
    <origin xyz="0 -0.0625 0.1502" rpy="1.5708 -0.30769 -3.1416"/>
    <parent link="Link1"/>
    <child link="Link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.8" upper="3.14" effort="30" velocity="3.14"/>
    <dynamics damping="5.0" friction="0.0"/>
  </joint>

  <link name="Link3">
    <inertial>
      <origin
        xyz="0.250990565530514 0.00808545394179894 -0.0222401755365892"
        rpy="0 0 0"/>
      <mass value="0.752556593812719"/>
      <inertia
        ixx="0.000425309657305075"
        ixy="-5.61728607430966E-05"
        ixz="-1.50015547434599E-06"
        iyy="0.00322998845965891"
        iyz="-5.25098997553526E-07"
        izz="0.00319703542103549"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Link3.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.26 0.26 0.29 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Link3.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="Joint3" type="revolute">
    <origin xyz="0.35 0 0.089" rpy="0 0 2.8339"/>
    <parent link="Link2"/>
    <child link="Link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="0.05" effort="5" velocity="3.14"/>
    <dynamics damping="3.0" friction="0.0"/>
  </joint>

  <link name="Link4">
    <inertial>
      <origin
        xyz="-0.0101264888829805 -9.43656253071801E-06 0.0183147239415546"
        rpy="0 0 0"/>
      <mass value="0.096843847451149"/>
      <inertia
        ixx="3.90651033692534E-05"
        ixy="-7.03126515657744E-09"
        ixz="1.31677639794987E-05"
        iyy="4.72677970007942E-05"
        iyz="-4.24198916633624E-09"
        izz="5.03679132119555E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Link4.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.30 0.30 0.30 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Link4.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="Joint4" type="revolute">
    <origin xyz="0.339 -0.024975 -0.04" rpy="1.5708 0 0"/>
    <parent link="Link3"/>
    <child link="Link4"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-3.1" upper="3.1" effort="1" velocity="1"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <link name="Link5">
    <inertial>
      <origin xyz="0.0012638 0.00010623 0.021049" rpy="0 0 0"/>
      <mass value="0.045324"/>
      <inertia
        ixx="9.6597E-06"
        ixy="4.2023E-08"
        ixz="1.6641E-06"
        iyy="1.3078E-05"
        iyz="-8.5768E-08"
        izz="8.9202E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Link5.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.27 0.28 0.27 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Link5.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="Joint5" type="revolute">
    <origin xyz="-0.022739 0 0.048353" rpy="-1.5708 0 -1.5708"/>
    <parent link="Link4"/>
    <child link="Link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7854" upper="0.7854" effort="1" velocity="1"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <link name="Link6">
    <inertial>
      <origin
        xyz="-0.000391828204109268 -5.10898276429028E-05 8.72654266097506E-05"
        rpy="0 0 0"/>
      <mass value="0.0550538676063611"/>
      <inertia
        ixx="1.97473690747458E-05"
        ixy="2.97287907271867E-08"
        ixz="-3.3993136804071E-08"
        iyy="1.6757375365036E-05"
        iyz="-1.34242857049597E-07"
        izz="1.07644206564509E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Link6.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.24 0.24 0.26 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/Link6.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="Joint6" type="revolute">
    <origin xyz="0 0 0.03484" rpy="3.1416 -1.5708 0"/>
    <parent link="Link5"/>
    <child link="Link6"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.5" upper="0.5" effort="1" velocity="1"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <link name="tool0"/>
  <joint name="tool0_joint" type="fixed">
    <parent link="Link6"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="tool0"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="0 -1.5708 3.1416"/>
  </joint>

  <!-- Arm joints 1-3: Gazebo simulation / future CANopen hardware plugin -->
  <ros2_control name="eMeetArm_hardware" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="Joint1">
      <command_interface name="position">
        <param name="min">-3.1</param>
        <param name="max">3.1</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Joint2">
      <command_interface name="position">
        <param name="min">-0.8</param>
        <param name="max">3.14</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Joint3">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">0.05</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Camera joints 4-6: EMEET PTZ HID hardware plugin -->
  <ros2_control name="eMeetCamera_hardware" type="system">
    <hardware>
      <plugin>emeet_camera_driver/CameraHardwareInterface</plugin>
      <param name="camera_type">auto</param>
      <param name="sim_mode">true</param>
    </hardware>
    <joint name="Joint4">
      <command_interface name="position">
        <param name="min">-3.1</param>
        <param name="max">3.1</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Joint5">
      <command_interface name="position">
        <param name="min">-0.7854</param>
        <param name="max">0.7854</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Joint6">
      <command_interface name="position">
        <param name="min">-1.5</param>
        <param name="max">0.5</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo reference="arm_base_link">
    <visual>
      <material>
        <ambient>0.55 0.57 0.60 1</ambient>
        <diffuse>0.75 0.77 0.80 1</diffuse>
        <specular>0.95 0.95 0.95 80</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="Link1">
    <visual>
      <material>
        <ambient>0.55 0.57 0.60 1</ambient>
        <diffuse>0.75 0.77 0.80 1</diffuse>
        <specular>0.95 0.95 0.95 80</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="Link2">
    <visual>
      <material>
        <ambient>0.55 0.57 0.60 1</ambient>
        <diffuse>0.75 0.77 0.80 1</diffuse>
        <specular>0.95 0.95 0.95 80</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="Link3">
    <visual>
      <material>
        <ambient>0.55 0.57 0.60 1</ambient>
        <diffuse>0.75 0.77 0.80 1</diffuse>
        <specular>0.95 0.95 0.95 80</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="Link4">
    <visual>
      <material>
        <ambient>0.55 0.57 0.60 1</ambient>
        <diffuse>0.75 0.77 0.80 1</diffuse>
        <specular>0.95 0.95 0.95 80</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="Link5">
    <visual>
      <material>
        <ambient>0.55 0.57 0.60 1</ambient>
        <diffuse>0.75 0.77 0.80 1</diffuse>
        <specular>0.95 0.95 0.95 80</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="Link6">
    <visual>
      <material>
        <ambient>0.55 0.57 0.60 1</ambient>
        <diffuse>0.75 0.77 0.80 1</diffuse>
        <specular>0.95 0.95 0.95 80</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
    <sensor name="camera_sensor" type="camera">
      <pose>0 0 0 -1.5708 0 0</pose>
      <camera name="head">
        <horizontal_fov>1.518</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <frame_name>camera_optical_frame</frame_name>
        <ros>
          <namespace>/camera</namespace>
        </ros>
      </plugin>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>CONTROLLERS_YAML_PATH</parameters>
    </plugin>
  </gazebo>

</robot>
