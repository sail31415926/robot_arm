<?xml version="1.0"?>
<!--
  arm.urdf.xacro — eMeetArm 机械臂可复用 xacro macro

  2026-07-28：云台由 V1（二轴 eMeetCamera / USB HID）换为 V2（C-200T 三轴 GCU 云台）。
  本文件只描述机械臂 J1-3 + 末端法兰 tool0；Joint4-6 及相机/ToF 全部来自
  robot_gimbal_description_v2 的 robot_gimbal_v2 macro，由下方 with_gimbal 开关注入。

  参数：
    parent           挂载父 link 名称（必填，例如 "base_link"）
    xyz              机械臂基座相对父 link 的位置偏移（默认 "0 0 0.31"）
    rpy              机械臂基座相对父 link 的姿态偏移（默认 "0 0 0"）
    with_gimbal      是否挂载云台 V2（默认 "true"；false = 只出 3 轴臂）
    sim_mode         云台 V2 转发插件是否仿真模式（默认 "true"）
                       true  → 回显指令作为状态，不发 ROS 话题（无实物场景）
                       false → 经 /robot_gimbal_v2/forward_cmd 转发（实物，须云台板端节点在跑）
    gazebo_camera    Joint4-6 是否交给 GazeboSystem（Gazebo 仿真设 true）
    emit_camera_control 是否生成云台 J4-6 的 ros2_control 块
    controllers_yaml gazebo_ros2_control 控制器配置文件路径
                       非空时插入 gazebo_ros2_control 插件
                       空字符串时跳过（由外层组合 xacro 统一注入）

  用法示例（在 full_robot.urdf.xacro 中挂到底盘）：
    <xacro:include filename="$(find robot_arm_description)/urdf/arm.urdf.xacro"/>
    <xacro:emeet_arm
        parent="base_link"
        xyz="0 0 0.31" rpy="0 0 0"
        sim_mode="true"
        controllers_yaml="$(find robot_arm_bringup)/config/controllers.yaml"/>

  用法示例（独立仿真，作为顶层 robot）：
    <robot name="eMeetArm" xmlns:xacro="http://www.ros.org/wiki/xacro">
      <xacro:include filename="$(find robot_arm_description)/urdf/arm.urdf.xacro"/>
      <link name="world"/>
      <xacro:emeet_arm parent="world" xyz="0 0 0" rpy="0 0 0"
                       sim_mode="true"
                       controllers_yaml="$(find robot_arm_bringup)/config/controllers.yaml"/>
    </robot>

  TF 树（挂载到底盘、with_gimbal=true 时）：
    ${parent}（底盘根节点）
      └─ arm_base_joint (fixed, offset = xyz/rpy)
           └─ arm_base_link
                └─ Joint1 → Link1
                     └─ Joint2 → Link2
                          └─ Joint3 → Link3
                               └─ tool0_joint (fixed, Link3 +X 300mm) → tool0   ← 臂末端法兰
                                    └─ gimbal_base_joint (fixed, 零偏移) → gimbal_base_link
                                         ├─ Cam1_joint (fixed) → Cam1     广角相机（基座固定）
                                         ├─ Tof_joint  (fixed) → Tof      ToF（基座固定）
                                         └─ Joint4 → Link4
                                              └─ Joint5 → Link5
                                                   └─ Joint6 → Link6
                                                        └─ gimbal_tool0_joint → gimbal_tool0
                                                             └─ Cam0_joint → Cam0  主相机（光学系）
                                                                  └─ camera_optical_joint
                                                                       → camera_optical_frame（零偏移别名）
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- 云台 V2（Joint4-6 + Cam0/Cam1/Tof）由独立描述包提供，见下方 with_gimbal -->
<xacro:include filename="$(find robot_gimbal_description_v2)/urdf/gimbal.urdf.xacro"/>

<xacro:macro name="emeet_arm"
             params="parent
                     xyz:='0 0 0.31'
                     rpy:='0 0 0'
                     sim_mode:='true'
                     gazebo_camera:='false'
                     backend:='gazebo'
                     arm_sim_mode:='false'
                     can_interface:='can0'
                     emit_camera_control:='true'
                     with_gimbal:='true'
                     controllers_yaml:=''">

  <!-- ══ 挂载关节：连接父 link 与机械臂基座 ══════════════════════════════════ -->
  <joint name="arm_base_joint" type="fixed">
    <parent link="${parent}"/>
    <child link="arm_base_link"/>
    <origin xyz="${xyz}" rpy="${rpy}"/>
  </joint>

  <!-- ══ Links ════════════════════════════════════════════════════════════════ -->

  <!-- 机械臂基座（原 eMeetArm_models.urdf 中的 base_link，重命名避免与底盘冲突） -->
  <link name="arm_base_link">
    <inertial>
      <origin xyz="-1.26513871156475E-05 -1.5742724565615E-05 0.0452777610383739" rpy="0 0 0"/>
      <mass value="2.9887249749171"/>
      <inertia ixx="0.0136862770640689" ixy="6.69045000229793E-07"  ixz="-3.08621535501323E-07"
               iyy="0.0112779246258948" iyz="-2.26930660317598E-07" izz="0.0223184454586288"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robot_arm_description/meshes/base_link.STL"/></geometry>
      <material name=""><color rgba="0.22 0.22 0.23 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robot_arm_description/meshes/base_link.STL"/></geometry>
    </collision>
  </link>

  <link name="Link1">
    <inertial>
      <origin xyz="-7.4393277062379E-05 -0.00743203317797858 0.128765008589431" rpy="0 0 0"/>
      <mass value="2.35824980558236"/>
      <inertia ixx="0.00383791573125331" ixy="7.01396501492847E-07"   ixz="-3.09202743571665E-06"
               iyy="0.00465819508220185" iyz="-0.000530039602599771"  izz="0.00221408091488039"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robot_arm_description/meshes/Link1.STL"/></geometry>
      <material name=""><color rgba="0.25 0.25 0.25 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robot_arm_description/meshes/Link1.STL"/></geometry>
    </collision>
  </link>

  <link name="Link2">
    <inertial>
      <origin xyz="0.262334166073163 -2.30075418332643E-05 0.0292792731278192" rpy="0 0 0"/>
      <mass value="1.23593589919935"/>
      <inertia ixx="0.000521066265507803" ixy="1.66498206532369E-07" ixz="1.28943373675324E-05"
               iyy="0.00836492400345204"  iyz="-2.82843566382884E-07" izz="0.00851304966664655"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robot_arm_description/meshes/Link2.STL"/></geometry>
      <material name=""><color rgba="0.28 0.27 0.27 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robot_arm_description/meshes/Link2.STL"/></geometry>
    </collision>
  </link>

  <link name="Link3">
    <inertial>
      <origin xyz="0.250990565530514 0.00808545394179894 -0.0222401755365892" rpy="0 0 0"/>
      <mass value="0.752556593812719"/>
      <inertia ixx="0.000425309657305075" ixy="-5.61728607430966E-05"  ixz="-1.50015547434599E-06"
               iyy="0.00322998845965891"  iyz="-5.25098997553526E-07"  izz="0.00319703542103549"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robot_arm_description/meshes/Link3.STL"/></geometry>
      <material name=""><color rgba="0.26 0.26 0.29 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://robot_arm_description/meshes/Link3.STL"/></geometry>
    </collision>
  </link>

  <!-- 臂末端法兰：云台（robot_gimbal_V2）的挂载面。
       2026-07-28 云台换 V2 后，原 Link4-6（V1 二轴云台几何）连同 J4-6 一并移出本文件，
       由 robot_gimbal_description_v2 的 robot_gimbal_v2 macro 提供。
       Link4-6/Link4-6.STL 的旧网格文件保留在 meshes/ 下未删（eMeetArm_models.urdf 仍引用）。 -->
  <link name="tool0"/>

  <!-- ══ Joints ═══════════════════════════════════════════════════════════════ -->

  <joint name="Joint1" type="revolute">
    <origin xyz="0 0 0.1078" rpy="0 0 0"/>
    <parent link="arm_base_link"/>
    <child link="Link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" effort="5" velocity="3.14"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <joint name="Joint2" type="revolute">
    <!-- 2026-07-28 实机重标定：新零点 = 旧 +0.181 rad。
         Origin_new = Origin_old·Rz(0.181)；roll=+π/2 使右乘 Rz 折叠为 pitch -= 0.181
         （-0.30769 → -0.48869）。限位随刻度整体平移 -0.181（物理行程不变）。 -->
    <origin xyz="0 -0.0625 0.1502" rpy="1.5708 -0.48869 -3.1416"/>
    <parent link="Link1"/>
    <child link="Link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.981" upper="2.959" effort="30" velocity="3.14"/>
    <dynamics damping="5.0" friction="0.0"/>
  </joint>

  <joint name="Joint3" type="revolute">
    <!-- 2026-07-28 实机重标定：新零点 = 旧 -0.176 rad。
         Origin_new = Origin_old·Rz(-0.176)；rpy 最右即 Rz，故 yaw += -0.176
         （2.8339 → 2.6579）。
         限位：按新零点收紧为 [-2.5, 0]（物理行程 [-2.964, 0.226] 内的人为限制）。
         2026-07-29 上限由 0.0 放宽到 0.02：上限精确压在工作点 0 上时，控制器稳态误差
         会让实测值一半的时间落在限位外，MoveIt 的 IK 会丢弃种子状态（刷
         "Initial guess exceeds joint limits"）、规划则报 Start state out of bounds。
         实测零位抖动 3.2e-5 rad，0.02 rad 留了 600 倍余量。 -->
    <origin xyz="0.35 0 0.089" rpy="0 0 2.6579"/>
    <parent link="Link2"/>
    <child link="Link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.5" upper="0.02" effort="5" velocity="3.14"/>
    <dynamics damping="3.0" friction="0.0"/>
  </joint>

  <!-- 臂末端法兰 tool0：Link3 坐标系 +X 方向 300 mm，绕 X 轴 +90°。
       云台 V2 的 gimbal_base_link 与本坐标系**完全重合**（gimbal_base_joint 零偏移零旋转），
       所以安装姿态一律写在这里，不写在 gimbal_base_joint 上——tool0 就是机械接口面的
       权威定义，改安装姿态只改这一处。
       注：与旧 Joint4 原点（xyz 0.339 -0.024975 -0.04 / rpy 1.5708 0 0）不同，
       这是换 V2 云台后重新定义的机械接口面。 -->
  <joint name="tool0_joint" type="fixed">
    <parent link="Link3"/>
    <child link="tool0"/>
    <origin xyz="0.3 0 0" rpy="1.5708 0 0"/>
  </joint>

  <!-- ══ ros2_control ══════════════════════════════════════════════════════════
       Arm joints 1-3：
         backend=gazebo（默认）→ GazeboSystem（Gazebo 仿真）
         backend=real          → robot_arm_driver/UnwrapRobotSystem（ros2_canopen CiA402 实物，
                                 继承 RobotSystem + 绝对编码器 2π 折算，保证回零走最短方向）
                                 总线拓扑/换算/PDO 见 robot_arm_driver/config/canopen/bus.yml
                                 arm_sim_mode=true → mock_components/GenericSystem
                                                     （命令回显为状态，不连 CAN，干跑）
       ═══════════════════════════════════════════════════════════════════════ -->
  <ros2_control name="eMeetArm_hardware" type="system">
    <hardware>
      <xacro:if value="${backend == 'real'}">
        <xacro:unless value="${arm_sim_mode}">
          <plugin>robot_arm_driver/UnwrapRobotSystem</plugin>
          <param name="bus_config">$(find robot_arm_driver)/config/canopen/bus.yml</param>
          <param name="master_config">$(find robot_arm_driver)/config/canopen/master.dcf</param>
          <param name="can_interface_name">${can_interface}</param>
        </xacro:unless>
        <xacro:if value="${arm_sim_mode}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
      </xacro:if>
      <xacro:unless value="${backend == 'real'}">
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </xacro:unless>
    </hardware>
    <joint name="Joint1">
      <param name="device_name">joint_1</param>
      <command_interface name="position">
        <param name="min">-2.618</param>
        <param name="max">2.618</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Joint2">
      <param name="device_name">joint_2</param>
      <command_interface name="position">
        <param name="min">-0.981</param>
        <param name="max">2.959</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Joint3">
      <param name="device_name">joint_3</param>
      <command_interface name="position">
        <param name="min">-2.5</param>
        <param name="max">0.02</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ══ 云台 V2（robot_gimbal_V2 / C-200T 三轴 GCU 云台）════════════════════════
       Joint4-6 的 link/joint/ros2_control 全部由 robot_gimbal_description_v2 的
       robot_gimbal_v2 macro 提供，本文件不再自带云台几何（2026-07-28 换 V2）。
       gimbal_base_link 与臂末端法兰 tool0 重合挂接（零偏移）。
       tool_link 改名为 gimbal_tool0：避免与臂侧 tool0 法兰重名。
       sim_mode / gazebo_camera / emit_camera_control 三个参数原样透传，
       下游 launch 的 mappings 不需要改。
       ═══════════════════════════════════════════════════════════════════════ -->
  <xacro:if value="${with_gimbal}">
    <!-- 与 tool0 完全重合：安装姿态写在 tool0_joint 上（见上），这里保持全零 -->
    <xacro:robot_gimbal_v2
        parent="tool0"
        xyz="0 0 0"
        rpy="0 0 0"
        sim_mode="${sim_mode}"
        gazebo_camera="${gazebo_camera}"
        emit_camera_control="${emit_camera_control}"
        tool_link="gimbal_tool0"
        controllers_yaml=""/>

    <!-- 兼容别名：V2 以 Cam0 的 link 系为光学系（REP-103，z 光轴 / y 下 / x 右），
         下游（IBVS、person_detector、planner、rviz 等）仍按 camera_optical_frame
         查 TF，这里做零偏移别名，语义完全等价。 -->
    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="Cam0"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <!-- ══ Gazebo 材质 ══════════════════════════════════════════════════════════ -->
  <gazebo reference="arm_base_link">
    <visual><material>
      <ambient>0.55 0.57 0.60 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse>
      <specular>0.95 0.95 0.95 80</specular><emissive>0 0 0 1</emissive>
    </material></visual>
  </gazebo>
  <gazebo reference="Link1">
    <visual><material>
      <ambient>0.55 0.57 0.60 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse>
      <specular>0.95 0.95 0.95 80</specular><emissive>0 0 0 1</emissive>
    </material></visual>
  </gazebo>
  <gazebo reference="Link2">
    <visual><material>
      <ambient>0.55 0.57 0.60 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse>
      <specular>0.95 0.95 0.95 80</specular><emissive>0 0 0 1</emissive>
    </material></visual>
  </gazebo>
  <gazebo reference="Link3">
    <visual><material>
      <ambient>0.55 0.57 0.60 1</ambient><diffuse>0.75 0.77 0.80 1</diffuse>
      <specular>0.95 0.95 0.95 80</specular><emissive>0 0 0 1</emissive>
    </material></visual>
  </gazebo>
  <!-- 云台 V2 的 link 材质与 Cam0 相机 sensor 由 robot_gimbal_v2 macro 自带，此处不重复。 -->

  <!-- ══ Gazebo ros2_control 插件 ══════════════════════════════════════════════
       controllers_yaml 非空时才插入，避免组合时重复注入
       ═══════════════════════════════════════════════════════════════════════ -->
  <xacro:if value="${controllers_yaml != ''}">
    <gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <parameters>${controllers_yaml}</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</xacro:macro>
</robot>
