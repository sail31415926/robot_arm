<mujoco model="eMeetArm">
  <!-- eulerseq XYZ = intrinsic roll-pitch-yaw, matches URDF rpy convention -->
  <compiler meshdir="../meshes" eulerseq="XYZ" angle="radian"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.3 0.3 0.3" specular="0.0 0.0 0.0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="Link1"     file="Link1.STL"/>
    <mesh name="Link2"     file="Link2.STL"/>
    <mesh name="Link3"     file="Link3.STL"/>
    <mesh name="Link4"     file="Link4.STL"/>
    <mesh name="Link5"     file="Link5.STL"/>
    <mesh name="Link6"     file="Link6.STL"/>
    <material name="arm_grey"   rgba="0.898 0.918 0.929 1"/>
    <material name="joint_grey" rgba="0.698 0.698 0.698 1"/>
  </asset>

  <default>
    <joint limited="true"/>
    <!-- visual: mesh rendering only, no physics collision -->
    <default class="visual">
      <geom contype="0" conaffinity="0" group="0"/>
    </default>
    <!-- robot_col: robot link collision shapes (contype=2), collide with world (conaffinity=1)
         but NOT with each other (world has conaffinity=2, robot has contype=2 → robot-robot: off) -->
    <default class="robot_col">
      <geom contype="2" conaffinity="1" group="3" rgba="0 0 0 0"/>
    </default>
    <!-- world_col: scene/object collision, collides with robot and other objects -->
    <default class="world_col">
      <geom contype="1" conaffinity="3" group="0"/>
    </default>
  </default>

  <worldbody>
    <!-- ── Lighting ────────────────────────────────────────────────────────── -->
    <light name="overhead" pos="0.75 0 3.0" dir="0 0 -1"
           diffuse="0.92 0.92 0.88" specular="0.3 0.3 0.3"/>
    <light name="side"     pos="1 1 1.5" dir="-1 -1 -1"
           diffuse="0.4 0.4 0.4"/>
    <light name="fill"     pos="-0.3 0.5 1.2"
           diffuse="0.55 0.55 0.60" specular="0.1 0.1 0.1"
           attenuation="0.3 0.1 0.01" cutoff="5"/>

    <!-- Ground collision plane (invisible) -->
    <geom name="ground_col" class="world_col" type="plane" size="5 5 0.1" rgba="0 0 0 0"/>

    <!-- ── Wood floor planks (alternating dark/light, visual only) ────────── -->
    <!-- 11 planks, 0.50×8.0m each, x=-1.25 to +3.75 -->
    <geom name="plank_d0" type="box" size="0.25 4.0 0.004"
          pos="-1.25 0 0.004" rgba="0.48 0.32 0.16 1" contype="0" conaffinity="0"/>
    <geom name="plank_l0" type="box" size="0.25 4.0 0.004"
          pos="-0.75 0 0.004" rgba="0.62 0.44 0.24 1" contype="0" conaffinity="0"/>
    <geom name="plank_d1" type="box" size="0.25 4.0 0.004"
          pos="-0.25 0 0.004" rgba="0.48 0.32 0.16 1" contype="0" conaffinity="0"/>
    <geom name="plank_l1" type="box" size="0.25 4.0 0.004"
          pos="0.25 0 0.004" rgba="0.62 0.44 0.24 1" contype="0" conaffinity="0"/>
    <geom name="plank_d2" type="box" size="0.25 4.0 0.004"
          pos="0.75 0 0.004" rgba="0.48 0.32 0.16 1" contype="0" conaffinity="0"/>
    <geom name="plank_l2" type="box" size="0.25 4.0 0.004"
          pos="1.25 0 0.004" rgba="0.62 0.44 0.24 1" contype="0" conaffinity="0"/>
    <geom name="plank_d3" type="box" size="0.25 4.0 0.004"
          pos="1.75 0 0.004" rgba="0.48 0.32 0.16 1" contype="0" conaffinity="0"/>
    <geom name="plank_l3" type="box" size="0.25 4.0 0.004"
          pos="2.25 0 0.004" rgba="0.62 0.44 0.24 1" contype="0" conaffinity="0"/>
    <geom name="plank_d4" type="box" size="0.25 4.0 0.004"
          pos="2.75 0 0.004" rgba="0.48 0.32 0.16 1" contype="0" conaffinity="0"/>
    <geom name="plank_l4" type="box" size="0.25 4.0 0.004"
          pos="3.25 0 0.004" rgba="0.62 0.44 0.24 1" contype="0" conaffinity="0"/>
    <geom name="plank_d5" type="box" size="0.25 4.0 0.004"
          pos="3.75 0 0.004" rgba="0.48 0.32 0.16 1" contype="0" conaffinity="0"/>

    <!-- ── Workbench (table) ──────────────────────────────────────────────── -->
    <body name="workbench" pos="0 0 0">
      <!-- Table surface: 1.00×1.00×0.04m, top at z=0.43 -->
      <geom name="table_top" class="world_col" type="box" size="0.50 0.50 0.02"
            pos="0.90 0 0.43" rgba="0.54 0.48 0.40 1"/>
      <geom name="leg_fl" class="world_col" type="box" size="0.025 0.025 0.205"
            pos="0.435 -0.455 0.205" rgba="0.45 0.45 0.45 1"/>
      <geom name="leg_fr" class="world_col" type="box" size="0.025 0.025 0.205"
            pos="0.435  0.455 0.205" rgba="0.45 0.45 0.45 1"/>
      <geom name="leg_bl" class="world_col" type="box" size="0.025 0.025 0.205"
            pos="1.365 -0.455 0.205" rgba="0.45 0.45 0.45 1"/>
      <geom name="leg_br" class="world_col" type="box" size="0.025 0.025 0.205"
            pos="1.365  0.455 0.205" rgba="0.45 0.45 0.45 1"/>
    </body>

    <!-- ── Inspection plate ───────────────────────────────────────────────── -->
    <geom name="plate" class="world_col" type="box" size="0.36 0.36 0.0025"
          pos="0.90 0 0.453" rgba="0.65 0.65 0.65 1"/>

    <!-- ── Cloth backdrops ────────────────────────────────────────────────── -->
    <geom name="cloth_back"  type="box" size="0.005 0.75 0.45"
          pos="1.60 0 0.45"    rgba="0.52 0.52 0.52 1" contype="0" conaffinity="0"/>
    <geom name="cloth_left"  type="box" size="0.65 0.005 0.45"
          pos="0.90 -0.70 0.45" rgba="0.52 0.52 0.52 1" contype="0" conaffinity="0"/>
    <geom name="cloth_right" type="box" size="0.65 0.005 0.45"
          pos="0.90  0.70 0.45" rgba="0.52 0.52 0.52 1" contype="0" conaffinity="0"/>

    <!-- ── Walls ──────────────────────────────────────────────────────────── -->
    <geom name="wall_back"  type="box" size="0.10 4.10 1.10"
          pos="4.00 0 1.10"    rgba="0.64 0.61 0.57 1" contype="0" conaffinity="0"/>
    <geom name="wall_left"  type="box" size="2.80 0.10 1.10"
          pos="1.30 -4.00 1.10" rgba="0.64 0.61 0.57 1" contype="0" conaffinity="0"/>
    <geom name="wall_right" type="box" size="2.80 0.10 1.10"
          pos="1.30  4.00 1.10" rgba="0.64 0.61 0.57 1" contype="0" conaffinity="0"/>

    <!-- ── Test objects (dynamic, can be manipulated) ─────────────────────── -->
    <body name="obj_red_box" pos="0.60 -0.12 0.47" euler="0 0 0.4">
      <inertial pos="0 0 0" mass="0.1" diaginertia="1e-4 1e-4 1e-4"/>
      <geom class="world_col" type="box" size="0.03 0.02 0.02" rgba="0.85 0.12 0.10 1"/>
      <freejoint/>
    </body>
    <body name="obj_blue_cyl" pos="0.92 0.10 0.485">
      <inertial pos="0 0 0" mass="0.15" diaginertia="1e-4 1e-4 5e-5"/>
      <geom class="world_col" type="cylinder" size="0.025 0.035" rgba="0.10 0.25 0.85 1"/>
      <freejoint/>
    </body>
    <body name="obj_green_box" pos="1.00 -0.08 0.4625" euler="0 0 -0.5">
      <inertial pos="0 0 0" mass="0.08" diaginertia="5e-5 5e-5 5e-5"/>
      <geom class="world_col" type="box" size="0.04 0.025 0.0125" rgba="0.10 0.72 0.22 1"/>
      <freejoint/>
    </body>
    <body name="obj_yellow_sphere" pos="0.80 0.13 0.475">
      <inertial pos="0 0 0" mass="0.05" diaginertia="2e-5 2e-5 2e-5"/>
      <geom class="world_col" type="sphere" size="0.025" rgba="0.95 0.82 0.05 1"/>
      <freejoint/>
    </body>

    <!-- base_link: fixed to world (no joint) -->
    <body name="base_link" pos="0 0 0">
      <inertial pos="-1.265e-05 -1.574e-05 0.04528" mass="2.9887"
                fullinertia="0.013686 0.011278 0.022318 6.69e-07 -3.086e-07 -2.269e-07"/>
      <geom class="visual" type="mesh" mesh="base_link" material="arm_grey"/>
      <geom class="robot_col" type="cylinder" size="0.065 0.054" pos="0 0 0.054"/>

      <!-- Link1: Joint1 — Z-axis rotation, base rotation -->
      <body name="Link1" pos="0 0 0.1078" euler="0 0 0">
        <inertial pos="-7.439e-05 -0.00743 0.12877" mass="2.3582"
                  fullinertia="0.003838 0.004658 0.002214 7.014e-07 -3.092e-06 -5.300e-04"/>
        <joint name="Joint1" type="hinge" axis="0 0 1" range="-3.1 3.1" damping="1.0"/>
        <geom class="visual" type="mesh" mesh="Link1" material="arm_grey"/>
        <geom class="robot_col" type="capsule" size="0.055" fromto="0 0 0  0 0 0.15"/>

        <!-- Link2: Joint2 — shoulder pitch -->
        <body name="Link2" pos="0 -0.0625 0.1502" euler="1.5708 -0.30769 -3.1416">
          <inertial pos="0.26233 -2.301e-05 0.02928" mass="1.2359"
                    fullinertia="5.211e-04 0.008365 0.008513 1.665e-07 1.289e-05 -2.828e-07"/>
          <joint name="Joint2" type="hinge" axis="0 0 1" range="-0.8 3.14" damping="5.0"/>
          <geom class="visual" type="mesh" mesh="Link2" material="arm_grey"/>
          <geom class="robot_col" type="capsule" size="0.045" fromto="0 0 0  0.35 0 0"/>

          <!-- Link3: Joint3 — elbow -->
          <body name="Link3" pos="0.35 0 0.089" euler="0 0 2.8339">
            <inertial pos="0.25099 0.00809 -0.02224" mass="0.7526"
                      fullinertia="4.253e-04 0.003230 0.003197 -5.617e-05 -1.500e-06 -5.251e-07"/>
            <joint name="Joint3" type="hinge" axis="0 0 1" range="-3.14 0.05" damping="3.0"/>
            <geom class="visual" type="mesh" mesh="Link3" material="arm_grey"/>
            <geom class="robot_col" type="capsule" size="0.038" fromto="0 0 0  0.34 0 0"/>

            <!-- Link4: Joint4 — wrist roll -->
            <body name="Link4" pos="0.339 -0.024975 -0.04" euler="1.5708 0 0">
              <inertial pos="-0.01013 -9.437e-06 0.01831" mass="0.09684"
                        fullinertia="3.907e-05 4.727e-05 5.037e-05 -7.031e-09 1.317e-05 -4.242e-09"/>
              <joint name="Joint4" type="hinge" axis="0 0 -1" range="-3.1 3.1" damping="0.5"/>
              <geom class="visual" type="mesh" mesh="Link4" material="joint_grey"/>
              <geom class="robot_col" type="capsule" size="0.030" fromto="0 0 0  0 0 0.05"/>

              <!-- Link5: Joint5 — wrist pitch -->
              <body name="Link5" pos="-0.022739 0 0.048353" euler="-1.5708 0 -1.5708">
                <inertial pos="0.001264 1.062e-04 0.02105" mass="0.04532"
                          fullinertia="9.660e-06 1.308e-05 8.920e-06 4.202e-08 1.664e-06 -8.577e-08"/>
                <joint name="Joint5" type="hinge" axis="0 0 1" range="-0.7854 0.7854" damping="0.5"/>
                <geom class="visual" type="mesh" mesh="Link5" material="joint_grey"/>
                <geom class="robot_col" type="sphere" size="0.028" pos="0 0 0.02"/>

                <!-- Link6: Joint6 — wrist yaw -->
                <body name="Link6" pos="0 0 0.03484" euler="3.1416 -1.5708 0">
                  <inertial pos="-3.918e-04 -5.109e-05 8.727e-05" mass="0.05505"
                            fullinertia="1.975e-05 1.676e-05 1.076e-05 2.973e-08 -3.399e-08 -1.342e-07"/>
                  <joint name="Joint6" type="hinge" axis="0 0 -1" range="-1.5 0.5" damping="0.5"/>
                  <geom class="visual" type="mesh" mesh="Link6" material="joint_grey"/>
                  <geom class="robot_col" type="sphere" size="0.025" pos="0 0 0"/>

                  <!-- tool0: end-effector frame (fixed, no joint) -->
                  <body name="tool0" pos="0 0 0">
                    <site name="ee_site" pos="0 0 0" size="0.01" rgba="1 0 0 0.5"/>
                    <!-- camera_optical_frame: matches URDF camera_optical_joint
                         joint rpy="0 -1.5708 3.1416", sensor pose rpy="-1.5708 0 0"
                         fovy=70.9° from URDF horizontal_fov=1.518rad (87°) at 640x480 (4:3) -->
                    <body name="camera_optical_frame" pos="0 0 0"
                          euler="0 -1.5708 3.1416">
                      <camera name="ee_cam" pos="0 0 0.04"
                              fovy="70.9" resolution="640 480"
                              xyaxes="1 0 0  0 -1 0"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!--
    Position actuators with velocity feedback (PD control):
      force = kp*(ctrl - qact) - kv*qvel
    kv tuned ~0.1-0.15*kp for near-critical damping, eliminating overshoot.
    Joint damping kept low as additional passive stabilization.
  -->
  <actuator>
    <position name="act_Joint1" joint="Joint1" kp="500" kv="60"/>
    <position name="act_Joint2" joint="Joint2" kp="800" kv="100"/>
    <position name="act_Joint3" joint="Joint3" kp="300" kv="40"/>
    <position name="act_Joint4" joint="Joint4" kp="80"  kv="12"/>
    <position name="act_Joint5" joint="Joint5" kp="50"  kv="8"/>
    <position name="act_Joint6" joint="Joint6" kp="50"  kv="8"/>
  </actuator>

</mujoco>
